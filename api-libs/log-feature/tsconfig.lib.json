{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ],
    "target": "es2021",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "references": [
    {
      "path": "../../shared-libs/grpc-types/tsconfig.lib.json"
    },
    {
      "path": "../log-utils/tsconfig.lib.json"
    },
    {
      "path": "../../shared-libs/rmq-messages/tsconfig.lib.json"
    }
  ]
}
