# Database ports
CARD_DB_PORT=5432
LOG_DB_PORT=5433
REPORT_DB_PORT=5434
USER_DB_PORT=5435

# Databases
CARD_DB_NAME=card-db
CARD_DB_USER=user
CARD_DB_PASSWORD=password
CARD_DB_URL=postgresql://user:password@localhost:5432/card-db?schema=public

LOG_DB_NAME=log-db
LOG_DB_USER=user
LOG_DB_PASSWORD=password
LOG_DB_URL=postgresql://user:password@localhost:5433/log-db?schema=public

REPORT_DB_NAME=report-db
REPORT_DB_USER=user
REPORT_DB_PASSWORD=password
REPORT_DB_URL=postgresql://user:password@localhost:5434/report-db?schema=public

USER_DB_NAME=user-db
USER_DB_USER=user
USER_DB_PASSWORD=password
USER_DB_URL=postgresql://user:password@localhost:5435/user-db?schema=public

# RabbitMQ
BANK_CRM_RMQ_PORT=5672
BANK_CRM_RMQ_MANAGEMENT_PORT=15672
BANK_CRM_RMQ_URL=localhost:5672
BANK_CRM_RMQ_USER=user
BANK_CRM_RMQ_PASSWORD=password

# Redis
BANK_CRM_REDIS_PORT=6379
BANK_CRM_REDIS_URL=redis://localhost:6379
BANK_CRM_REDIS_PASSWORD=password
BANK_CRM_LOG_CACHE_TTL=60

# Application
BANK_CRM_DEV_MODE=true
BANK_CRM_JWT_SECRET=change-me-in-production

BANK_CRM_GATEWAY_HTTP_PORT=4000
BANK_CRM_GATEWAY_HOST=localhost
BANK_CRM_CLIENT_PORT=8081
BANK_CRM_GATEWAY_WINDOW_MS_MINUTES=15
BANK_CRM_GATEWAY_REQUEST_LIMIT=1000
BANK_CRM_GATEWAY_CORS_ORIGINS=http://localhost:4200,http://localhost:8081

# gRPC
BANK_CRM_CARD_GRPC_PORT=5000
BANK_CRM_LOG_GRPC_PORT=5001
BANK_CRM_REPORT_GRPC_PORT=5002
BANK_CRM_USER_GRPC_PORT=5003

BANK_CRM_CARD_GRPC_URL=localhost:5000
BANK_CRM_LOG_GRPC_URL=localhost:5001
BANK_CRM_REPORT_GRPC_URL=localhost:5002
BANK_CRM_USER_GRPC_URL=localhost:5003

# Docker images
DOCKER_REGISTRY=registry.example.com
DOCKER_APPS_VERSION=latest
